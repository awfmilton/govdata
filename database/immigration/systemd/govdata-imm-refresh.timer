[Unit]
Description=Weekly govdata.ca immigration data check (IRCC publishes monthly, StatCan quarterly)

[Timer]
# Mondays 14:30 UTC. A check is a metadata request per source (CKAN / StatCan WDS / HTTP validators); a source is
# downloaded only when its publisher has released something new, and the country pages are rebuilt only then.
OnCalendar=Mon *-*-* 14:30:00 UTC
RandomizedDelaySec=900
Persistent=true

[Install]
WantedBy=timers.target
