[Unit]
Description=Monthly rebuild of the govdata.ca country pages

[Timer]
# The 1st of each month, 07:30 UTC. OECD and Global Affairs publish yearly, the IRB quarterly; unchanged files are
# not downloaded (HTTP validators / table fingerprints).
OnCalendar=*-*-01 07:30:00 UTC
RandomizedDelaySec=10m
Persistent=true

[Install]
WantedBy=timers.target
