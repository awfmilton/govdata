[Unit]
Description=Weekly House of Commons / LEGISinfo / Justice Laws refresh for govdata.ca

[Timer]
# Saturdays 06:00 UTC: the week's divisions (the House sits Monday-Friday), new bills and law amendments.
OnCalendar=Sat *-*-* 06:00:00 UTC
RandomizedDelaySec=900
Persistent=true

[Install]
WantedBy=timers.target
