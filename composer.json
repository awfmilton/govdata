{
  "name": "publictech/govdata",
  "description": "PublicTech audit-terminal WordPress suite: parent theme, child theme, MCP server plugin.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "yoast/phpunit-polyfills": "^3.0",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "phpstan/phpstan": "^1.12"
  },
  "autoload-dev": {
    "psr-4": {
      "PublicTech\\Tests\\": "tests/php/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true,
    "platform": {
      "php": "8.1"
    }
  },
  "scripts": {
    "lint": [
      "find publictech-core publictech-terminal publictech-mcp -name '*.php' -print0 | xargs -0 -n1 -P4 php -l > /dev/null"
    ],
    "phpcs": "phpcs",
    "phpcbf": "phpcbf",
    "phpstan": "phpstan analyse --memory-limit=512M",
    "test": "phpunit",
    "ci": [
      "@lint",
      "@phpcs",
      "@phpstan",
      "@test"
    ]
  }
}
