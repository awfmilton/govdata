{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": [
    "plugin:@wordpress/eslint-plugin/recommended"
  ],
  "globals": {
    "d3": "readonly",
    "PT_BOOT": "readonly",
    "PT_THEME_DEFAULT": "readonly",
    "PT": "writable",
    "wp": "readonly"
  },
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "@wordpress/no-unsafe-wp-apis": "off",
    "no-unused-vars": ["warn", { "args": "none" }],
    "prefer-const": "warn"
  },
  "overrides": [
    {
      "files": ["**/*.config.js", "**/.*rc.js"],
      "env": { "node": true }
    }
  ]
}
